rules_version = '2';

// Boodschappen — security rules.
// Uitgangspunt: alles dicht, tenzij hieronder expliciet toegestaan.
// - Alleen leden van een huishouden lezen/schrijven de data ervan.
// - Privé-items en -lijsten (ownerUid = uid) zijn alleen voor die gebruiker.
// - Verwijderen mag de eigenaar van het huishouden (de wipe), en iedereen
//   die erbij kan voor iets dat al langer dan 7 dagen in de prullenbak ligt.
//   Gewone "verwijderingen" in de app zijn een deleted-vlag, dus een update.
// - Het activiteitenlog is alleen toevoegen: nooit aanpassen.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    // Lezen en verwijderen: kijk naar de huidige staat.
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(householdPath(hid)).data.members;
    }

    function isOwner(hid) {
      return signedIn() && get(householdPath(hid)).data.ownerUid == request.auth.uid;
    }

    // Schrijven: kijk naar de staat ná de write, zodat een huishouden en
    // de eerste lijsten/secties in één batch aangemaakt kunnen worden.
    function isMemberAfter(hid) {
      return signedIn() && request.auth.uid in getAfter(householdPath(hid)).data.members;
    }

    // 'shared' = voor iedereen in het huishouden, anders alleen voor die uid.
    function visibleFor(ownerUid) {
      return ownerUid == 'shared' || ownerUid == request.auth.uid;
    }

    // Ligt al langer dan 7 dagen in de prullenbak (deleted-vlag + tijdstip).
    function trashedLongEnough() {
      return resource.data.get('deleted', false) == true
        && request.time > resource.data.get('deletedAt', resource.data.updatedAt) + duration.value(7, 'd');
    }

    // De uitnodiging die bij deze batch hoort was nog vrij, en is in déze batch
    // door jou gebruikt. Een oude, al gebruikte uitnodiging telt dus niet.
    function joinedWith(hid, code) {
      let path = /databases/$(database)/documents/invites/$(code);
      return get(path).data.usedBy == null
        && getAfter(path).data.hid == hid
        && getAfter(path).data.usedBy == request.auth.uid;
    }

    // Uitnodigingen. De code is het geheim: wie hem kent mag hem lezen, maar
    // niemand kan door de lijst bladeren (alleen je eigen uitnodigingen).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && get(householdPath(request.resource.data.hid)).data.ownerUid == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.revoked == false;
      // Gebruiken: één keer, niet verlopen, niet ingetrokken, alleen op je eigen naam.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.revoked == false
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);
      // Intrekken door de maker (en daarna niet meer terug te draaien).
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.revoked == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt']);
      allow delete: if false;
    }

    // Eigen profiel: alleen jezelf.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Leden mogen bijv. de naam aanpassen, maar eigenaar en leden niet.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.members == resource.data.members
        && request.resource.data.get('lastJoinCode', null) == resource.data.get('lastJoinCode', null)
        && request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {}))
             .affectedKeys().hasOnly([request.auth.uid]);

      // Meedoen via een uitnodiging: jezelf (en alleen jezelf) achteraan toevoegen,
      // in dezelfde batch waarin de uitnodiging op jouw naam als gebruikt wordt gezet.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberNames', 'lastJoinCode', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && joinedWith(hid, request.resource.data.lastJoinCode);

      // De eigenaar mag leden verwijderen (niet zichzelf).
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.members
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'updatedAt', 'updatedBy']);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Lijsten en items: gedeeld of privé.
      match /lists/{id} {
        allow read: if isMember(hid) && visibleFor(resource.data.ownerUid);
        allow create: if isMemberAfter(hid) && visibleFor(request.resource.data.ownerUid);
        allow update: if isMemberAfter(hid)
          && visibleFor(resource.data.ownerUid)
          && visibleFor(request.resource.data.ownerUid);
        allow delete: if isOwner(hid);
      }

      match /items/{id} {
        allow read: if isMember(hid) && visibleFor(resource.data.ownerUid);
        allow create: if isMemberAfter(hid) && visibleFor(request.resource.data.ownerUid);
        allow update: if isMemberAfter(hid)
          && visibleFor(resource.data.ownerUid)
          && visibleFor(request.resource.data.ownerUid);
        allow delete: if isOwner(hid)
          || (isMember(hid) && visibleFor(resource.data.ownerUid) && trashedLongEnough());
      }

      match /products/{id} {
        // Productgeheugen: gedeeld (s_…) of privé (u_<uid>_…).
        allow read: if isMember(hid) && visibleFor(resource.data.ownerUid);
        allow create: if isMemberAfter(hid) && visibleFor(request.resource.data.ownerUid);
        allow update: if isMemberAfter(hid)
          && visibleFor(resource.data.ownerUid)
          && visibleFor(request.resource.data.ownerUid);
        allow delete: if isOwner(hid)
          || (isMember(hid) && visibleFor(resource.data.ownerUid) && trashedLongEnough());
      }

      // Rondes (historie): gedeeld of privé, net als items.
      match /trips/{id} {
        allow read: if isMember(hid) && visibleFor(resource.data.ownerUid);
        allow create: if isMemberAfter(hid) && visibleFor(request.resource.data.ownerUid);
        allow update: if isMemberAfter(hid)
          && visibleFor(resource.data.ownerUid)
          && visibleFor(request.resource.data.ownerUid);
        allow delete: if isOwner(hid);
      }

      // Activiteitenlog: toevoegen als jezelf, nooit aanpassen.
      match /activity/{id} {
        allow read: if isMember(hid) && visibleFor(resource.data.get('ownerUid', 'shared'));
        allow create: if isMemberAfter(hid)
          && request.resource.data.by == request.auth.uid
          && visibleFor(request.resource.data.ownerUid);
        allow update: if false;
        allow delete: if isOwner(hid);
      }

      // Overige collecties van het huishouden (winkels, ketens, secties,
      // suggesties): gedeeld binnen het huishouden.
      match /{collectionName}/{id} {
        allow read: if isMember(hid)
          && collectionName in ['stores', 'chains', 'sections', 'suggestions'];
        allow create, update: if isMemberAfter(hid)
          && collectionName in ['stores', 'chains', 'sections', 'suggestions'];
        // Prullenbak legen: winkels en eigen secties (standaardsecties nooit).
        allow delete: if collectionName in ['stores', 'chains', 'sections', 'suggestions']
          && (isOwner(hid)
            || (isMember(hid)
              && collectionName in ['stores', 'sections']
              && (collectionName != 'sections' || resource.data.get('custom', false) == true)
              && trashedLongEnough()));
      }
    }
  }
}
